{
  "name": "session-flow",
  "displayName": "Session Flow",
  "description": "열린 작업 폴더의 Claude Code 세션들을 하네스(멤버·역할·메인·메시지 방향)로 설계하고, 실행 흐름과 파일 전/후 변경을 한 화면에서 확인·개입합니다.",
  "version": "0.10.1",
  "publisher": "tjehdgus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tjehdgus/session-flow"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "agents",
    "diff",
    "timeline"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionFlow",
          "title": "Session Flow",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sessionFlow": [
        {
          "id": "sessionFlow.sessions",
          "name": "하네스"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionFlow.openHarness",
        "title": "Session Flow: 하네스 열기",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "sessionFlow.askWrite",
        "title": "Session Flow: 세션에게 하네스 작성 맡기기",
        "icon": "$(sparkle)"
      },
      {
        "command": "sessionFlow.fixNames",
        "title": "Session Flow: 멤버 세션 이름 맞추기 (/rename)",
        "icon": "$(tag)"
      },
      {
        "command": "sessionFlow.openClaude",
        "title": "Session Flow: Claude Code에서 열기",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sessionFlow.openTimeline",
        "title": "Session Flow: 기록 열기",
        "icon": "$(graph-line)"
      },
      {
        "command": "sessionFlow.refresh",
        "title": "Session Flow: 새로고침",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionFlow.openDataFolder",
        "title": "Session Flow: 기록 폴더 열기",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sessionFlow.openEvent",
        "title": "Session Flow: 이벤트 열기"
      },
      {
        "command": "sessionFlow.focusMember",
        "title": "Session Flow: 멤버 이벤트 보기"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionFlow.openHarness",
          "when": "view == sessionFlow.sessions",
          "group": "navigation@0"
        },
        {
          "command": "sessionFlow.refresh",
          "when": "view == sessionFlow.sessions",
          "group": "navigation@1"
        },
        {
          "command": "sessionFlow.openDataFolder",
          "when": "view == sessionFlow.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionFlow.openHarness",
          "when": "view == sessionFlow.sessions && viewItem == folder",
          "group": "inline"
        },
        {
          "command": "sessionFlow.askWrite",
          "when": "view == sessionFlow.sessions && viewItem == folder",
          "group": "inline"
        },
        {
          "command": "sessionFlow.openClaude",
          "when": "view == sessionFlow.sessions && viewItem == session",
          "group": "inline"
        },
        {
          "command": "sessionFlow.openTimeline",
          "when": "view == sessionFlow.sessions && viewItem == session",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionFlow.openEvent",
          "when": "false"
        },
        {
          "command": "sessionFlow.openClaude",
          "when": "false"
        },
        {
          "command": "sessionFlow.focusMember",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Session Flow",
      "properties": {
        "sessionFlow.dataDir": {
          "type": "string",
          "default": "",
          "description": "기록 폴더 경로. 비워두면 ~/.session-flow (또는 SESSION_FLOW_DIR 환경변수)를 사용합니다."
        }
      }
    }
  }
}
